# ADD these lines to the END of /opt/homepage/.env
# Do NOT delete the HOMEPAGE_ALLOWED_HOSTS line that is already in that file.
# If a value contains $ or #, wrap it in single quotes: 'pa$$word'

# Proxmox API token (read-only, PVEAuditor role)
HOMEPAGE_VAR_PROXMOX_TOKEN_ID=root@pam!homepage
HOMEPAGE_VAR_PROXMOX_TOKEN_SECRET=paste-the-token-secret-here

# AdGuard Home admin login
HOMEPAGE_VAR_ADGUARD_USER=your-adguard-username
HOMEPAGE_VAR_ADGUARD_PASS=your-adguard-password

# Weather location (use city-center coordinates, not your home)
HOMEPAGE_VAR_LATITUDE=0.00
HOMEPAGE_VAR_LONGITUDE=0.00
